{
  "name": "mycrm-desktop",
  "version": "0.1.7",
  "private": true,
  "description": "MyCRM desktop connection device",
  "main": "src/main.cjs",
  "author": "MyCRM",
  "license": "UNLICENSED",
  "scripts": {"start":"electron .", "test":"node --test test/*.test.cjs", "dist":"electron-builder --publish never"},
  "dependencies": {"electron-updater":"6.8.11"},
  "devDependencies": {"@electron/osx-sign":"1.3.3", "electron":"45.1.0", "electron-builder":"26.18.0"},
  "build": {
    "appId":"io.mycrm.desktop",
    "productName":"MyCRM",
    "directories":{"output":"../release/desktop"},
    "files":["src/**/*", "package.json"],
    "extraResources":[{"from":"../release/agent", "to":"agent", "filter":["**/*"]}],
    "asar":true,
    "protocols":[{"name":"MyCRM", "schemes":["mycrm"]}],
    "artifactName":"MyCRM-${version}-${os}-${arch}.${ext}",
    "mac":{"category":"public.app-category.productivity", "target":["dmg","zip"], "hardenedRuntime":true, "identity":"-", "sign":"./scripts/mac-sign.cjs"},
    "win":{"target":[{"target":"nsis","arch":["x64"]}]},
    "nsis":{"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":false,"deleteAppDataOnUninstall":false,"createDesktopShortcut":true,"createStartMenuShortcut":true},
    "publish":{"provider":"github", "owner":"WJY-ador", "repo":"personal-mycrm"}
  }
}
